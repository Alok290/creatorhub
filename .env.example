# Database (optional — defaults to embedded file-based H2 in local dev)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/creatorhub?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASS=your_secure_db_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# JWT Security (use a strong 256-bit hex secret in production)
JWT_SECRET=replace_with_a_strong_256_bit_hex_secret_key
JWT_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Meta / Instagram OAuth (Instagram API with Unified Login)
INSTAGRAM_CONFIG_ID=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5173/auth/callback/instagram

# Razorpay Payment Gateway (Optional - CreatorHub has built-in Direct Escrow Vault fallback)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Platform Settings
PLATFORM_FEE_PERCENTAGE=5.0

# Real Telecom SMS Provider (Configure in Render / Production)
# Option 1: Twilio (Global / US / India)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 2: Fast2SMS (India Quick OTP)
FAST2SMS_API_KEY=

# Option 3: 2Factor (India)
TWOFACTOR_API_KEY=

# Option 4: MSG91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

